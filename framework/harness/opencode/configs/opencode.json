{
    "$schema": "https://opencode.ai/config.json",
    "formatter": true,
    "lsp": false,
    "plugin": [
      "@prevalentware/opencode-goal-plugin"
    ],
    "instructions": ["AGENTS.md", "system-prompt.md"],
    "references": {
      "standards": {
          "path": "framework/references/standards",
          "description": "Canonical engineering standards referenced by skills."
      },
      "templates": {
        "path": "framework/references/templates",
        "description": "Ready-to-use workflow documents."
      }
    },
    "mcp": {
      "chrome-devtools": {
          "type": "local",
          "command": ["bun", "x", "chrome-devtools-mcp@latest"],
          "enabled": true
      },
      "notion": {
          "type": "remote",
          "url": "https://mcp.notion.com/mcp",
          "enabled": true
      }
    }
}
