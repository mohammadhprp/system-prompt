{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": false,
  "plugin": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "instructions": [
    "AGENTS.md",
    "system-prompt.md"
  ],
  "agent": {
    "plan": {
      "color": "#ff3b30"
    },
    "build": {
      "color": "#007aff"
    }
  },
  "references": {
    "standards": {
      "path": "framework/references/standards",
      "description": "Canonical engineering standards referenced by skills."
    },
    "templates": {
      "path": "framework/references/templates",
      "description": "Ready-to-use workflow documents."
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  }
}
